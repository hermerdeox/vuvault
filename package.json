{
  "name": "vuvault-zero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "dev:vite": "vite",
    "dev:ngrok": "vite --config vite.config.ngrok.ts",
    "tunnel": "./start-tunnel.sh",
    "tunnel:sudo": "./start-ngrok.sh",
    "build": "bun run build:app",
    "build:app": "bun build ./index.html --outdir ./dist --minify",
    "build:vite": "vite build",
    "preview": "bun server.ts",
    "type-check": "tsc --noEmit",
    "pages:deploy": "npx wrangler pages deploy dist --project-name=vuvault-zero",
    "deploy": "npx wrangler pages deploy dist --project-name=vuvault-zero",
    "deploy:cloudflare": "bun run build && bunx wrangler pages deploy dist --project-name=vuvault-zero --commit-dirty=true",
    "analyze": "vite build --mode analyze",
    "clean:cache": "rm -rf node_modules/.vite dist",
    "test:build": "bun run build && bun run preview"
  },
  "dependencies": {
    "@metamask/browser-passworder": "^6.0.0",
    "@noble/ciphers": "^1.3.0",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "@simplewebauthn/browser": "^13.0.0",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.3",
    "dexie": "^4.0.0",
    "motion": "^11.0.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.22",
    "@types/node": "^22.0.0",
    "buffer": "^6.0.3",
    "bun-types": "^1.2.22",
    "crypto-browserify": "^3.12.0",
    "stream-browserify": "^3.0.0",
    "terser": "^5.0.0",
    "typescript": "^5.0.0",
    "unocss": "^66.0.0",
    "vite": "^5.4.13",
    "vite-plugin-node-polyfills": "^0.22.0",
    "vite-plugin-pwa": "^1.0.0",
    "vite-plugin-solid": "^2.0.0",
    "wrangler": "^4.0.0"
  }
}