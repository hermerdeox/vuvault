{
  "name": "vuvault",
  "version": "0.1.0",
  "private": true,
  "description": "VuVault — zero-knowledge password manager. Mathematical privacy, not policy. Quantum-safe by construction.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/build-manifest.mjs",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:fips": "vitest run kat.test",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.50.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.0.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "prettier": "^3.4.0",
    "prettier-plugin-svelte": "^3.3.0",
    "svelte": "^5.20.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.2.0",
    "@noble/curves": "^1.8.0",
    "@noble/hashes": "^1.7.0",
    "@noble/post-quantum": "0.4.1",
    "@structured-id/opaque": "1.0.4",
    "argon2id": "1.0.1",
    "dexie": "^4.0.10",
    "lottie-web": "^5.13.0"
  }
}
