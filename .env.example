# Public env vars exposed to the client. Do not commit a `.env` derived
# from this; the bundle hash is regenerated by CI.

PUBLIC_BUNDLE_HASH=9f4c7d2e8b16a4f122e0d5c83a7e91b4
PUBLIC_VAULT_VERSION=0.1.0

# Allow demo-mode authentication (deterministic stand-in PRF). MUST be
# unset or false in production builds. Used only for local evaluation
# on browsers without WebAuthn PRF support. CI fails production tagged
# builds if this is set to true.
PUBLIC_ENABLE_DEMO_AUTH=false
