# dependencies
node_modules/

# build output
.svelte-kit/
build/
dist/
.output/

# wrangler / cloudflare
.wrangler/

# OS junk
.DS_Store
Thumbs.db

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# env files (NEVER commit secrets)
.env
.env.*
!.env.example

# defensive: never commit ad-hoc credential files. If you ever paste a
# Cloudflare token / API key into a markdown for an agent to read, the
# file MUST live behind one of these patterns (and you should rotate
# the credential immediately afterward).
docs/API-KEY*
docs/SECRET*
docs/CREDENTIALS*
**/*-KEY.md
**/*-TOKEN.md
**/*-SECRET.md

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# coverage / test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/

# vitest cache
.vitest-cache/

# generated bundle hash (re-derived in CI)
.bundle-manifest

# wrangler types output (regenerated on every `wrangler types` call;
# keeping it out of the tree avoids spurious diffs on contributors who
# run a different wrangler version)
worker-configuration.d.ts
